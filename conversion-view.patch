+/* Education-to-employment conversion view. Reuses tokens and existing research/scene classes. */
+.conversion-facts { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); row-gap: 20px; }
+.conversion-facts > div:nth-child(n) { border-left: 1px solid var(--border); }
+.conversion-facts > div:first-child { border-left: 0; }
+.conversion-profile { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px; margin: 18px 0 0; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; background: var(--border); }
+.conversion-profile > div { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px; background: var(--bg); }
+.conversion-profile dt { font-size: 11px; color: var(--text-secondary); }
+.conversion-profile dd { margin: 0; font-size: 17px; font-variant-numeric: tabular-nums; }
+.conversion-profile small, .conversion-table small { font-size: 10px; color: var(--text-muted); }
+.conversion-table > div, .conversion-table { max-height: none; }
